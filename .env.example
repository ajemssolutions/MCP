# --- Server ---
PORT=8080

# Public HTTPS address of THIS server, no trailing slash.
# Users paste this + /mcp into Claude or ChatGPT.
PUBLIC_URL=https://mcp.ajems.com

# How an organisation name becomes an API base URL. {org} is filled in at sign-in.
AJEMS_HOST_TEMPLATE=https://{org}.buildprohub-server.com/json_builder

# --- Behaviour ---
# Rows scanned when computing a count or total. Counts are exact below this;
# above it they are clearly reported as a lower bound.
SCAN_LIMIT=50000

# Row sets larger than this bypass the cache, to bound memory across tenants.
CACHE_MAX_ROWS=20000

# Ceiling on record data returned in one response, in characters.
MAX_RETURN_CHARS=60000
ALLOW_WRITES=true

# Signed-in sessions, so restarts don't log everyone out.
# Contains tenant secret keys — keep out of git and backups.
SESSION_FILE=./sessions.json

# --- Load handling (safe defaults; tune against real traffic) ---
RATE_LIMIT_PER_MIN=90         # tool calls per connected session
MAX_CONCURRENT_UPSTREAM=12    # simultaneous requests to AJEMS
UPSTREAM_TIMEOUT_MS=20000     # give up on a slow AJEMS response
CONFIG_CACHE_MS=60000         # workspace_config cache
ROWS_CACHE_MS=20000           # record list cache

# --- Search ceilings (the search tool scans records across forms) ---
SEARCH_MAX_FORMS=15
SEARCH_MAX_ROWS=500
SEARCH_MAX_RESULTS=40

# --- Optional: fixed token for CLI clients and scripts, bypassing OAuth ---
# Leave blank in production.
DEV_TOKEN=
DEV_ORG=
DEV_SECRET_KEY=
