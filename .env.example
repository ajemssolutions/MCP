# AJEMS connector (MCP) — LIVE server at https://mcp.ajems.com
# Copy this file to .env in the same folder and fill in the two keys. Nothing else to change.

PORT=8080
PUBLIC_URL=https://mcp.ajems.com

# Where each workspace's AJEMS lives ({org} = the workspace name the person types)
AJEMS_API_TEMPLATE=https://{org}.buildprohub-server.com
AJEMS_WEB_TEMPLATE=https://{org}.ajems.in

# The same value as AJEN_MCP_SERVER_SECRET in the LIVE Backend/.env
AJEMS_SERVER_SECRET=

# One fixed key for this server, made once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=

# Live only accepts Claude's and ChatGPT's own return addresses (no localhost)
ALLOW_LOCAL_REDIRECTS=false
